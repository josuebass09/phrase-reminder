# Postgres connection string. On Railway, reference the Postgres service's DATABASE_URL.
DATABASE_URL=postgresql://user:password@host:5432/railway

# Web service only. Signs the hour-long access tokens. Use at least 32 random characters,
# such as from: openssl rand -base64 32. To log everyone out, use: npm run users -- log-out --all
SESSION_SECRET=

# Web service only, optional. The app's URL, so it can call the API from its own domain.
# Separate several with commas, such as https://app.up.railway.app,http://localhost:5173
APP_ORIGIN=

# Web service only, optional. A contact email for the free MyMemory translation API,
# which raises its daily limit from about 5,000 to 50,000 characters.
MYMEMORY_EMAIL=

# Web service only, optional. New translations each user may ask for per day; the admin
# has no limit. Defaults to 30.
TRANSLATIONS_PER_DAY=

# Web service only, optional. A free Groq API key (https://console.groq.com/keys) for the
# formal and informal ways to say a new phrase. Without it, suggestions are off.
GROQ_API_KEY=
# Optional. The Groq model to use. Defaults to openai/gpt-oss-120b.
GROQ_MODEL=
# Optional. Suggestions each user may ask for per day; the admin has no limit. Defaults to 20.
SUGGESTIONS_PER_DAY=
# Optional. The same key scores how users say their phrases aloud. The Groq speech model
# to use, which defaults to whisper-large-v3-turbo, and the scores each user may get per day,
# which defaults to 20.
GROQ_TRANSCRIPTION_MODEL=
PRONUNCIATIONS_PER_DAY=

# Web and cron services. Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=

# Cron service only. Keep the private key secret.
VAPID_PRIVATE_KEY=
# A contact address with no spaces, such as mailto:you@example.com
VAPID_SUBJECT=
