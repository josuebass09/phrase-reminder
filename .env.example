# Postgres connection string. On Railway, reference the Postgres service's DATABASE_URL.
DATABASE_URL=postgresql://user:password@host:5432/railway

# Web service only. Signs the 12-hour access tokens. Use at least 32 random characters,
# such as from: openssl rand -base64 32. Changing it logs out every device.
SESSION_SECRET=

# Web service only, optional. The app's URL, so it can call the API from its own domain.
# Separate several with commas, such as https://app.up.railway.app,http://localhost:5173
APP_ORIGIN=

# Web and cron services. Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=

# Cron service only. Keep the private key secret.
VAPID_PRIVATE_KEY=
# A contact address with no spaces, such as mailto:you@example.com
VAPID_SUBJECT=
